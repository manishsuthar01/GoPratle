{
  "name": "gopratle-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GoPratle - Requirement Management Platform Monorepo",
  "scripts": {
    "dev:web": "pnpm --filter @gopratle/web dev",
    "dev:api": "pnpm --filter @gopratle/api dev",
    "build": "pnpm --filter @gopratle/shared build && pnpm --filter @gopratle/api build && pnpm --filter @gopratle/web build",
    "build:web": "pnpm --filter @gopratle/shared build && pnpm --filter @gopratle/web build",
    "build:api": "pnpm --filter @gopratle/shared build && pnpm --filter @gopratle/api build",
    "start:api": "pnpm --filter @gopratle/api start",
    "test": "pnpm --filter @gopratle/shared test && pnpm --filter @gopratle/api test && pnpm --filter @gopratle/web test",
    "test:api": "pnpm --filter @gopratle/api test",
    "test:web": "pnpm --filter @gopratle/web test",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
